APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mapayanan_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="YOUR_GMAIL_ADDRESS@gmail.com"
MAIL_PASSWORD="YOUR_16_CHARACTER_GMAIL_APP_PASSWORD"
MAIL_FROM_ADDRESS="YOUR_GMAIL_ADDRESS@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Which transport SystemMail should use: "smtp" or "gmail_api".
# "gmail_api" is reserved for the Gmail REST API + OAuth2 transport
# (see app/Support/GmailApiTransport.php). SMTP is the working default.
GMAIL_TRANSPORT=smtp

# Comma-separated addresses that receive system notifications.
# Leave empty to notify every account holding the admin role.
MSWD_NOTIFY_EMAILS=

# --- Gmail REST API / OAuth2 (only needed if GMAIL_TRANSPORT=gmail_api) ---
# Copy .env.example to .env and fill in real values. Never commit .env.
GMAIL_OAUTH_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GMAIL_OAUTH_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GMAIL_OAUTH_REDIRECT_URI="${APP_URL}/gmail/oauth/callback"
GMAIL_OAUTH_SCOPES="https://www.googleapis.com/auth/gmail.send"
GMAIL_OAUTH_ACCESS_TOKEN="YOUR_ACCESS_TOKEN"
GMAIL_OAUTH_REFRESH_TOKEN="YOUR_REFRESH_TOKEN"
GMAIL_SEND_AS=""

# --- Database backups ---
# Directory for .sql dumps. MUST stay outside the public/ web root.
BACKUP_DIR=storage/app/private/backups
# Absolute path to mysqldump. Leave empty to auto-detect (XAMPP/WAMP/Laragon).
BACKUP_MYSQLDUMP=
# How many backups to keep before the oldest are pruned.
BACKUP_KEEP=10
# Default state of the automatic-backup toggle on the Backups page.
BACKUP_AUTO_ENABLED=false
# How often an automatic backup should run, in hours.
BACKUP_AUTO_EVERY_HOURS=24

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
